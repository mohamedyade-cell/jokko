PORT=3000
BASE_URL=https://jokko.example.com
SESSION_SECRET=remplacez-par-une-longue-chaine-aleatoire
# Jeton partagé avec LinkedIn / Indeed / votre connecteur pour le webhook de candidatures
INTEGRATION_TOKEN=
DATABASE_PATH=./data/jokko.db
UPLOAD_DIR=./uploads
# Pays (ISO 3166-1 alpha-2) et devise utilisés dans les flux XML
JOB_COUNTRY=SN
JOB_CURRENCY=XOF
# Comptes de l'équipe Jokko (vérification des certifications, écoles partenaires, offres PME / Corporate)
ADMIN_EMAILS=admin@jokko.example.com
# Quiz : délai avant de retenter après un échec, validité d'un badge
QUIZ_COOLDOWN_DAYS=3
BADGE_VALIDITY_DAYS=365
# Optionnel : recompression serveur des vidéos envoyées depuis un téléphone (480p, ~500 kbit/s)
FFMPEG_PATH=
# Fuseau horaire des entretiens (Africa/Dakar = GMT toute l'année)
JOKKO_TZ=Africa/Dakar
