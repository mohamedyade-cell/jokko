# Copier en .env et compléter. Ne jamais versionner .env.
# Clé de signature des sessions (48+ caractères aléatoires) :
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
RADAR_SECRET_KEY=
# Base de données : SQLite en monoposte, PostgreSQL en serveur
RADAR_DATABASE_URL=sqlite:///./radar_app.db
# Mot de passe PostgreSQL (docker-compose uniquement)
POSTGRES_PASSWORD=
# Dossier contenant les PDF CCI (lecture seule) pour l'affichage des sources
RADAR_PDF_DIR=
RADAR_PDF_HOST_DIR=./pdf
# Durée de session (minutes)
RADAR_TOKEN_TTL_MINUTES=600
# true derrière HTTPS (obligatoire en production)
RADAR_COOKIE_SECURE=false
# Comptes locaux (true/false) — à désactiver si Microsoft 365 est seul autorisé
RADAR_LOCAL_AUTH=true
# Microsoft Entra ID (seulement si autorisé par la DSI)
RADAR_ENTRA_TENANT_ID=
RADAR_ENTRA_CLIENT_ID=
RADAR_ENTRA_CLIENT_SECRET=
RADAR_ENTRA_REDIRECT_URI=
