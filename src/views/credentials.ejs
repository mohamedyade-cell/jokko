<%- include('partials/header') %>
<div class="layout-2">
  <div>
    <div class="card">
      <h1>Certifications</h1>
      <p class="muted">Langues, logiciels, habilitations, formations professionnelles : ajoutez vos certifications reconnues. Une fois vérifiées par l'équipe Jokko, elles deviennent des badges.</p>
      <form method="post" action="/profile/credentials" enctype="multipart/form-data" class="form form-grid">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="type" value="certification">
        <label>Intitulé <input name="title" required placeholder="ex. TOEIC 850, CACES R489, PSC1"></label>
        <label>Organisme <input name="issuer" required placeholder="ex. ETS Global, Croix-Rouge"></label>
        <label>Date d'obtention <input type="month" name="obtained_on"></label>
        <label>N° ou lien de vérification <input name="reference"></label>
        <label class="span-2">Justificatif <small class="muted">(PDF, JPG, PNG – 5 Mo max)</small> <input type="file" name="proof" accept=".pdf,.jpg,.jpeg,.png"></label>
        <div class="span-2"><button class="btn">Envoyer pour vérification</button></div>
      </form>
    </div>

    <div class="card">
      <h2>Jokko Campus</h2>
      <p class="muted">Étudiant ou diplômé d'une école partenaire ? Obtenez le badge de votre établissement.</p>
      <% if (!schools.length) { %>
        <p class="muted small">Aucune école partenaire pour le moment.</p>
      <% } else { %>
      <form method="post" action="/profile/credentials" enctype="multipart/form-data" class="form form-grid">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="type" value="campus">
        <label>École
          <select name="school_id" required>
            <% schools.forEach(function (s) { %><option value="<%= s.id %>"><%= s.name %><%= s.city ? ' (' + s.city + ')' : '' %></option><% }) %>
          </select>
        </label>
        <label>Formation / diplôme <input name="title" placeholder="ex. Licence Comptabilité"></label>
        <label>Année <input name="obtained_on" placeholder="2025"></label>
        <label>Justificatif <small class="muted">(carte d'étudiant, diplôme…)</small> <input type="file" name="proof" accept=".pdf,.jpg,.jpeg,.png"></label>
        <div class="span-2"><button class="btn btn-outline">Demander le badge</button></div>
      </form>
      <% } %>
    </div>
  </div>

  <aside class="card">
    <h3>Mes demandes</h3>
    <% if (!credentials.length) { %><p class="muted small">Aucune demande.</p><% } %>
    <% credentials.forEach(function (c) { %>
      <div class="experience">
        <strong><%= c.type === 'campus' ? '🎓 ' + (c.school_name || c.title) : c.title %></strong>
        <div class="small muted"><%= c.type === 'campus' ? c.title : c.issuer %><%= c.obtained_on ? ' · ' + c.obtained_on : '' %></div>
        <span class="status status-<%= c.status %>"><%= { pending: 'En cours de vérification', verified: 'Vérifié · badge attribué', rejected: 'Refusé' }[c.status] %></span>
        <% if (c.review_note) { %><div class="small muted"><%= c.review_note %></div><% } %>
        <% if (c.status !== 'verified') { %>
          <form method="post" action="/profile/credentials/<%= c.id %>/delete" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link small">Supprimer</button>
          </form>
        <% } %>
      </div>
    <% }) %>
  </aside>
</div>
<%- include('partials/footer') %>
