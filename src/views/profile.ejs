<%- include('partials/header') %>
<% var isCandidate = profile.role === 'candidate'; var displayName = full ? profile.name : h.shortName(profile.name); %>
<div class="card profile-card <%= isCandidate ? 'has-pitch' : '' %>">
  <% if (isCandidate) { %>
    <div class="profile-pitch">
      <%- include('partials/pitch', { user: profile }) %>
      <% if (relation === 'self') { %><a class="small" href="/profile/video"><%= profile.video_path ? 'Refaire mon pitch' : '+ Enregistrer mon pitch vidéo (90 s)' %></a><% } %>
    </div>
  <% } else { %>
    <%- include('partials/avatar', { name: profile.name, size: 'xl' }) %>
  <% } %>
  <div class="grow">
    <div class="row wrap">
      <div class="grow">
        <h1><%= displayName %></h1>
        <p class="lead"><%= profile.headline %></p>
      </div>
      <% if (isCandidate) { %><%- include('partials/score', { skills: score.skills, referral: score.referral }) %><% } %>
    </div>
    <p class="muted">
      <%= profile.location %><% if (profile.location) { %> · <% } %><%= connectionsCount %> relation<%= connectionsCount > 1 ? 's' : '' %>
      <% if (profile.role === 'recruiter' && profile.company_name) { %> · Recrute pour <strong><%= profile.company_name %></strong><% } %>
    </p>
    <% if (isCandidate && profile.available_now) { %><span class="tag tag-green">Disponible immédiatement</span><% } %>
    <% if (isCandidate) { %><%- include('partials/badges', { badges, emptyText: relation === 'self' ? 'Passez un quiz pour obtenir vos premiers badges.' : 'Aucun badge pour le moment.' }) %><% } %>

    <div class="row wrap profile-actions">
      <% if (relation === 'self') { %>
        <a class="btn btn-outline btn-small" href="/profile/edit">Modifier</a>
        <% if (isCandidate) { %><a class="btn btn-outline btn-small" href="/skills">Passer un quiz</a><% } %>
      <% } else if (relation === 'connected') { %>
        <form method="post" action="/network/remove/<%= profile.id %>" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-outline btn-small">✓ En relation</button>
        </form>
      <% } else if (relation === 'sent') { %>
        <span class="tag">Invitation envoyée</span>
      <% } else { %>
        <form method="post" action="/network/connect/<%= profile.id %>" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-small"><%= relation === 'received' ? 'Accepter l’invitation' : 'Se connecter' %></button>
        </form>
      <% } %>
    </div>
  </div>
</div>

<% if (isCandidate && !full && currentUser.role === 'recruiter') { %>
  <div class="card unlock-box">
    <div class="grow">
      <h2>🔒 CV complet verrouillé</h2>
      <p class="muted">Expériences, CV, coordonnées : débloquez ce profil pour y accéder. Le candidat entre alors dans votre pipeline.
        <% if (recruiterUsage.unlocksLeft !== null) { %>Il vous reste <strong><%= recruiterUsage.unlocksLeft %></strong> déblocage<%= recruiterUsage.unlocksLeft > 1 ? 's' : '' %> ce mois-ci.<% } %></p>
    </div>
    <% if (unlockJobs.length) { %>
      <form method="post" action="/ats/talents/<%= profile.id %>/unlock" class="unlock-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <select name="job_id" aria-label="Poste"><% unlockJobs.forEach(function (j) { %><option value="<%= j.id %>"><%= j.title %></option><% }) %></select>
        <button class="btn">Débloquer le CV</button>
      </form>
    <% } else { %>
      <a class="btn btn-outline" href="/ats/jobs/new">Créer une offre pour débloquer</a>
    <% } %>
  </div>
<% } %>

<% if (isCandidate && full && relation !== 'self') { %>
  <div class="card row wrap">
    <span class="grow">📇 <a href="mailto:<%= profile.email %>"><%= profile.email %></a><%= profile.phone ? ' · ' + profile.phone : '' %></span>
    <% if (profile.cv_path) { %><a class="btn btn-outline btn-small" href="/profile/<%= profile.id %>/cv">Télécharger le CV</a><% } %>
  </div>
<% } %>

<% if (profile.about && (full || currentUser.role === 'candidate')) { %>
<div class="card"><h2>Infos</h2><p class="pre"><%= profile.about %></p></div>
<% } %>

<% if (h.splitSkills(profile.skills).length) { %>
<div class="card"><h2>Compétences déclarées</h2><div class="tags">
  <% h.splitSkills(profile.skills).forEach(function (s) { %><span class="tag"><%= s %></span><% }) %>
</div></div>
<% } %>

<% if (experiences.length) { %>
<div class="card"><h2>Expérience</h2>
  <% experiences.forEach(function (e) { %>
    <div class="experience">
      <strong><%= e.title %></strong> · <%= e.company %>
      <div class="muted small"><%= e.start_date %> – <%= e.end_date || "aujourd'hui" %></div>
      <% if (e.description) { %><p class="pre"><%= e.description %></p><% } %>
    </div>
  <% }) %>
</div>
<% } %>

<% if (posts.length) { %>
<div class="card"><h2>Activité</h2>
  <% posts.forEach(function (p) { %>
    <div class="experience"><p class="pre"><%= p.content %></p><div class="muted small"><%= h.timeAgo(p.created_at) %></div></div>
  <% }) %>
</div>
<% } %>
<%- include('partials/footer') %>
