<%- include('partials/header') %>
<a href="/messages" class="small">← Messages</a>
<div class="layout-2">
  <div class="card thread">
    <div class="thread-head">
      <h1><%= thread.side === 'candidate' ? thread.company_name : thread.candidate_name %></h1>
      <p class="muted small"><%= thread.job_title %> · <span class="stage stage-<%= thread.stage %>"><%= thread.side === 'candidate' ? h.candidateStageLabel(thread.stage) : h.stageLabel(thread.stage) %></span>
        <% if (thread.side === 'recruiter') { %> · <a href="/ats/applications/<%= thread.id %>">Fiche candidat</a><% } %></p>
    </div>
    <div class="messages">
      <% if (!messages.length) { %><p class="muted center small">Aucun message pour l'instant. <%= thread.side === 'candidate' ? 'Vous pouvez écrire au recruteur ici.' : 'Écrivez au candidat : il sera notifié.' %></p><% } %>
      <% messages.forEach(function (m) { var mine = m.sender_id === currentUser.id; %>
        <div class="msg <%= mine ? 'msg-mine' : '' %>">
          <div class="msg-bubble pre"><%= m.body %></div>
          <div class="msg-meta small muted"><%= mine ? 'Vous' : m.sender_name %> · <%= h.timeAgo(m.created_at) %><%= mine && m.read_at ? ' · Lu' : '' %></div>
        </div>
      <% }) %>
      <span id="bas"></span>
    </div>
    <form method="post" action="/messages/<%= thread.id %>" class="row msg-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <textarea name="body" rows="2" placeholder="Votre message…" required maxlength="5000" class="grow"></textarea>
      <button class="btn">Envoyer</button>
    </form>
  </div>
  <aside>
    <div class="card">
      <h3>Entretiens</h3>
      <% if (!interviews.length) { %><p class="muted small"><%= thread.side === 'candidate' ? 'Aucun entretien prévu pour le moment.' : 'Planifiez un entretien depuis la fiche candidat.' %></p><% } %>
      <% interviews.forEach(function (i) { %><%- include('partials/interview-card', { i, side: thread.side }) %><% }) %>
    </div>
  </aside>
</div>
<%- include('partials/footer') %>
